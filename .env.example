# Copy to .env.local for development. In production these come from real
# environment variables and secrets — the application cannot tell the difference,
# which is the point.

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- infrastructure -------------------------------------------------------
DATABASE_URL=postgres://lernova:lernova@postgres:5432/lernova?sslmode=disable
NATS_URL=nats://nats:4222
REDIS_URL=redis://redis:6379
PARSER_ADDR=parser:50051

STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=50

# --- models ---------------------------------------------------------------
# The application only knows the LLM and Embedder interfaces. Switching from a
# local model to a hosted one is these variables and a restart — no code change.
#
# Local (default, no API keys, nothing leaves the machine):
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://ollama:11434

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_DIMENSIONS=768

# Hosted alternative — comment out the block above and use:
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=<model-id>
# LLM_BASE_URL=https://<host>/v1
# LLM_API_KEY=<key>

# WARNING: EMBEDDING_DIMENSIONS must match the schema (768). Changing the
# embedding model changes the dimension and invalidates every stored vector.
# That requires a migration and a full re-embed — the app refuses to start on a
# mismatch rather than silently corrupting similarity scores.

# --- observability --------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
