# Copy to .env.local for development. In production these come from real
# environment variables and secrets, the application cannot tell the difference,
# which is the point.

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- infrastructure -------------------------------------------------------
DATABASE_URL=postgres://skriptra:skriptra@postgres:5432/skriptra?sslmode=disable
NATS_URL=nats://nats:4222
REDIS_URL=redis://redis:6379
PARSER_ADDR=parser:50051

STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=50

# --- OCR (optional) -------------------------------------------------------
# Reading text off a photograph or a scan. Leave unset and those uploads are
# refused with a message naming the missing capability, rather than being
# accepted and indexed as nothing. Digital PDFs and Word files never touch it.
#
#   docker compose --profile ocr up
OCR_URL=http://ocr:50052

# --- authentication -------------------------------------------------------
# HS256 signing key for access tokens. The process refuses to start without at
# least 32 bytes, because a weak key means forgeable sessions on a service that
# would otherwise look perfectly healthy.
#
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48_at_least_32_bytes

# Send the refresh cookie only over TLS. Off locally, because a Secure cookie
# over plain HTTP is silently dropped and the failure looks like a server bug.
# Required outside development; the config refuses to start otherwise.
COOKIE_SECURE=false

# --- models ---------------------------------------------------------------
# The application only knows the LLM and Embedder interfaces. Switching from a
# local model to a hosted one is these variables and a restart, no code change.
#
# Local (default, no API keys, nothing leaves the machine).
#
# These point at the ollama service, which is behind the local-llm profile:
#
#   docker compose --profile local-llm up
#   docker compose exec ollama ollama pull llama3.2:3b
#   docker compose exec ollama ollama pull nomic-embed-text
#
# Already running Ollama on the host? Point at it instead and skip the profile
# and the download:
#
#   LLM_BASE_URL=http://host.docker.internal:11434
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://ollama:11434

# nomic-embed-text is 768-dimensional, which is what the schema expects.
# Changing this model changes the dimension and invalidates every stored vector.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_DIMENSIONS=768

# Hosted alternative, comment out the block above and use:
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=<model-id>
# LLM_BASE_URL=https://<host>/v1
# LLM_API_KEY=<key>

# WARNING: EMBEDDING_DIMENSIONS must match the schema (768). Changing the
# embedding model changes the dimension and invalidates every stored vector.
# That requires a migration and a full re-embed, the app refuses to start on a
# mismatch rather than silently corrupting similarity scores.

# --- observability --------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
